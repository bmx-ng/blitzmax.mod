Type TBccMessages
	Function SourceFileNotFound:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_SOURCE_FILE_NOT_FOUND, "Source file was not found")
	End Function
	Function CompilerModuleDeclarationMismatch:TLocalisedMessage(declaredName:String, expectedName:String)
		Return TLocalisedMessage.Create("bcc", BCC_MSG_COMPILER_MODULE_DECLARATION_MISMATCH, "Module declaration '{declaredName}' does not match path-derived module name '{expectedName}'", [TMessageArg.Create("declaredName", declaredName), TMessageArg.Create("expectedName", expectedName)])
	End Function
	Function CompilerConditionalDirectivesRemained:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_COMPILER_CONDITIONAL_DIRECTIVES_REMAINED, "Conditional directives remained after source configuration was applied")
	End Function
	Function EmissionCRequiresSuccessfulIr:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_EMISSION_C_REQUIRES_SUCCESSFUL_IR, "Successful compiler IR is required before C emission")
	End Function
	Function EmissionRuntimeCRequiresSuccessfulIr:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_EMISSION_RUNTIME_C_REQUIRES_SUCCESSFUL_IR, "Successful compiler IR is required before runtime-compatible C emission")
	End Function
	Function EmissionRuntimeHeaderRequiresSuccessfulIr:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_EMISSION_RUNTIME_HEADER_REQUIRES_SUCCESSFUL_IR, "Successful compiler IR is required before runtime header emission")
	End Function
	Function EmissionInterfaceRequiresSuccessfulIr:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_EMISSION_INTERFACE_REQUIRES_SUCCESSFUL_IR, "Successful compiler IR is required before compact interface emission")
	End Function
	Function GenericTemplateArtifactsRequirePlan:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_GENERIC_TEMPLATE_ARTIFACTS_REQUIRE_PLAN, "Compiler generic application plan is required before template artifact emission")
	End Function
	Function GenericManifestRequiresPlan:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_GENERIC_MANIFEST_REQUIRES_PLAN, "Compiler generic application plan is required before manifest emission")
	End Function
	Function BuildOutputRequiresSuccessfulIr:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_OUTPUT_REQUIRES_SUCCESSFUL_IR, "Successful compiler IR is required before build-output planning")
	End Function
	Function BuildOutputPathMustBeBoundedRelative:TLocalisedMessage(path:String)
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_OUTPUT_PATH_MUST_BE_BOUNDED_RELATIVE, "Generated output path must be a bounded relative path: '{path}'", [TMessageArg.Create("path", path)])
	End Function
	Function BuildOutputPathCollision:TLocalisedMessage(path:String)
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_OUTPUT_PATH_COLLISION, "Generated output path collision for '{path}'", [TMessageArg.Create("path", path)])
	End Function
	Function BuildOutputGenericLinkPathUnsafe:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_OUTPUT_GENERIC_LINK_PATH_UNSAFE, "Generic link input contains an unsafe generated path")
	End Function
	Function BuildManifestVersionUnsupportedOrMissing:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MANIFEST_VERSION_UNSUPPORTED_OR_MISSING, "Unsupported or missing compiler build manifest version")
	End Function
	Function BuildManifestFileRecordMalformed:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MANIFEST_FILE_RECORD_MALFORMED, "Malformed file record in compiler build manifest")
	End Function
	Function BuildManifestFilePathUnsafe:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MANIFEST_FILE_PATH_UNSAFE, "Unsafe file path in compiler build manifest")
	End Function
	Function BuildManifestFilePathDuplicate:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MANIFEST_FILE_PATH_DUPLICATE, "Duplicate file path in compiler build manifest")
	End Function
	Function BuildManifestLinkIdentityMalformed:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MANIFEST_LINK_IDENTITY_MALFORMED, "Malformed link identity in compiler build manifest")
	End Function
	Function BuildManifestLinkPathUnsafe:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MANIFEST_LINK_PATH_UNSAFE, "Unsafe link path in compiler build manifest")
	End Function
	Function BuildManifestLinkInputDuplicate:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MANIFEST_LINK_INPUT_DUPLICATE, "Duplicate specialization link input in compiler build manifest")
	End Function
	Function BuildManifestRecordUnknownOrMalformed:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MANIFEST_RECORD_UNKNOWN_OR_MALFORMED, "Unknown or malformed compiler build manifest record")
	End Function
	Function BuildManifestEncodedFieldMalformed:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MANIFEST_ENCODED_FIELD_MALFORMED, "Malformed encoded field in compiler build manifest")
	End Function
	Function BuildMaterializationPlanRequired:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MATERIALIZATION_PLAN_REQUIRED, "A valid build-output plan is required before materialization")
	End Function
	Function BuildMaterializationRootRequired:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MATERIALIZATION_ROOT_REQUIRED, "Build-output root must not be empty")
	End Function
	Function BuildMaterializationManifestPathMustBeBoundedRelative:TLocalisedMessage()
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MATERIALIZATION_MANIFEST_PATH_MUST_BE_BOUNDED_RELATIVE, "Build manifest path must be a bounded relative path")
	End Function
	Function BuildMaterializationRootCreationFailed:TLocalisedMessage(path:String)
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MATERIALIZATION_ROOT_CREATION_FAILED, "Unable to create build-output root '{path}'", [TMessageArg.Create("path", path)])
	End Function
	Function BuildMaterializationRootNotDirectory:TLocalisedMessage(path:String)
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MATERIALIZATION_ROOT_NOT_DIRECTORY, "Build-output root is not a directory: '{path}'", [TMessageArg.Create("path", path)])
	End Function
	Function BuildMaterializationOutputPathUnsafe:TLocalisedMessage(path:String)
		Return TLocalisedMessage.Create("bcc", BCC_MSG_BUILD_MATERIALIZATION_OUTPUT_PATH_UNSAFE, "Refusing to materialize unsafe output path '{path}'", [TMessageArg.Create("path", path)])
