	Function ParserExpressionNestingTooDeep:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPRESSION_NESTING_TOO_DEEP, "Expression nesting is too deep to parse safely.")
	End Function
	Function ParserExpectedExpression:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_EXPRESSION, "Expected an expression.")
	End Function
	Function ParserUnexpectedTokenInExpression:TLocalisedMessage(token:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_UNEXPECTED_TOKEN_IN_EXPRESSION, "Unexpected token '{token}' in expression.", [TMessageArg.Create("token", token)])
	End Function
	Function ParserExpectedCloseParenthesis:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_CLOSE_PARENTHESIS, "Expected ')' to close expression.")
	End Function
	Function ParserExpectedQualifiedSuperInterface:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_QUALIFIED_SUPER_INTERFACE, "Expected an Interface type in qualified Super expression.")
	End Function
	Function ParserExpectedExpressionFoundToken:TLocalisedMessage(token:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_EXPRESSION_FOUND_TOKEN, "Expected an expression but found '{token}'.", [TMessageArg.Create("token", token)])
	End Function
	Function ParserExpectedParenthesisAfterArguments:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_PARENTHESIS_AFTER_ARGUMENTS, "Expected ')' after argument list.")
	End Function
	Function ParserExpectedBracketAfterIndexes:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_BRACKET_AFTER_INDEXES, "Expected ']' after index list.")
	End Function
	Function ConstantDivisionByZero:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_CONSTANT_DIVISION_BY_ZERO, "Division by zero in constant expression.")
	End Function
	Function TypeExpectedTypeArguments:TLocalisedMessage(typeName:String, expected:Long, supplied:Long)
		Return TLocalisedMessage.CreatePlural("language", LANGUAGE_MSG_TYPE_EXPECTED_TYPE_ARGUMENTS, "expected", ["", "Type '{typeName}' expects one type argument, but {supplied} were supplied.", "", "", "", "Type '{typeName}' expects {expected} type arguments, but {supplied} were supplied."], [TMessageArg.Create("typeName", typeName), TMessageArg.CreateInt("expected", expected), TMessageArg.CreateInt("supplied", supplied)])
	End Function
	Function ConditionalExpectedExpression:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_CONDITIONAL_EXPECTED_EXPRESSION, "Expected a conditional-compilation expression.")
	End Function
	Function ConditionalUnexpectedToken:TLocalisedMessage(token:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_CONDITIONAL_UNEXPECTED_TOKEN, "Unexpected token '{token}' in conditional-compilation expression.", [TMessageArg.Create("token", token)])
	End Function
	Function ConditionalExpectedCloseParenthesis:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_CONDITIONAL_EXPECTED_CLOSE_PARENTHESIS, "Expected ')' in conditional-compilation expression.")
	End Function
	Function ConditionalExpectedOperand:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_CONDITIONAL_EXPECTED_OPERAND, "Expected a target symbol, 'Not', or '('.")
	End Function
	Function ParserParenthesizeCalculatedFromEndEndpoint:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_PARENTHESIZE_CALCULATED_FROM_END_ENDPOINT, "Parenthesize a calculated from-end Range endpoint as '^(expression)'.")
	End Function
	Function ParserFromEndEndpointRequiresRange:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_FROM_END_ENDPOINT_REQUIRES_RANGE, "A from-end endpoint requires a Range expression.")
	End Function
	Function ParserExpectedBracketAfterSlice:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_BRACKET_AFTER_SLICE, "Expected ']' after slice.")
	End Function
	Function ParserPostfixTypeRequiresNumericLiteral:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_POSTFIX_TYPE_REQUIRES_NUMERIC_LITERAL, "A postfix ':Type' is valid only on a numeric literal; use Type(expression) for an explicit conversion.")
	End Function
	Function ParserExpectedTypeAfterNew:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_TYPE_AFTER_NEW, "Expected a type after 'New'.")
	End Function
	Function ParserExpectedParenthesisAfterConstructorArguments:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_PARENTHESIS_AFTER_CONSTRUCTOR_ARGUMENTS, "Expected ')' after constructor arguments.")
	End Function
	Function ParserExpectedBracketAfterArrayLiteral:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_BRACKET_AFTER_ARRAY_LITERAL, "Expected ']' after array literal.")
	End Function
	Function ParserExpectedParenthesisAfterCast:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_PARENTHESIS_AFTER_CAST, "Expected ')' after cast expression.")
	End Function
