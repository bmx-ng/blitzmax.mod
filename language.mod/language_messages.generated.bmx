		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_FUNCTION_LITERAL_REQUIRES_SUPER_STRICT, "Function literals require SuperStrict mode.")
	End Function
	Function BindingFunctionLiteralParameterCountMismatch:TLocalisedMessage(actualCount:Long, targetType:String, requiredCount:Long)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_FUNCTION_LITERAL_PARAMETER_COUNT_MISMATCH, "Function literal has {actualCount} parameters but target type '{targetType}' requires {requiredCount}.", [TMessageArg.CreateInt("actualCount", actualCount), TMessageArg.Create("targetType", targetType), TMessageArg.CreateInt("requiredCount", requiredCount)])
