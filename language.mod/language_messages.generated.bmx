		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_LOOP_LABEL_NAME, "Expected a loop-label name after '#'.")
	End Function
	Function ParserUnexpectedTokenAfterLoopLabel:TLocalisedMessage(token:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_UNEXPECTED_TOKEN_AFTER_LOOP_LABEL, "Unexpected token '{token}' after loop label.", [TMessageArg.Create("token", token)])
	End Function
	Function ParserExpectedEndIf:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_END_IF, "Expected 'End If' or 'EndIf'.")
	End Function
	Function ParserExpectedEndWhile:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_END_WHILE, "Expected 'Wend' or 'End While'.")
	End Function
	Function ParserExpectedRepeatTerminator:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_REPEAT_TERMINATOR, "Expected 'Until' or 'Forever'.")
	End Function
	Function ParserExpectedNext:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_NEXT, "Expected 'Next'.")
	End Function
	Function ParserExpectedForLoopHeader:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_FOR_LOOP_HEADER, "Expected a For-loop header.")
	End Function
	Function ParserExpectedEqualsInForLoopHeader:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_EQUALS_IN_FOR_LOOP_HEADER, "Expected '=' in For-loop header.")
	End Function
	Function ParserExpectedLocalLoopVariableBeforeEquals:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_LOCAL_LOOP_VARIABLE_BEFORE_EQUALS, "Expected a local loop variable before '='.")
	End Function
	Function ParserExpectedLoopTargetBeforeEquals:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_LOOP_TARGET_BEFORE_EQUALS, "Expected a loop target before '='.")
	End Function
	Function ParserExpectedForLoopClause:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_FOR_LOOP_CLAUSE, "Expected 'EachIn', 'To', or 'Until' in For-loop header.")
	End Function
	Function ParserEachInMustFollowEquals:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EACH_IN_MUST_FOLLOW_EQUALS, "'EachIn' must immediately follow '='.")
	End Function
	Function ParserExpectedCollectionAfterEachIn:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_COLLECTION_AFTER_EACH_IN, "Expected a collection after 'EachIn'.")
	End Function
	Function ParserMultipleForBindingsRequireEachIn:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_MULTIPLE_FOR_BINDINGS_REQUIRE_EACH_IN, "Multiple For-loop bindings are valid only with 'EachIn'.")
	End Function
	Function ParserExpectedInitialValueBeforeRangeClause:TLocalisedMessage(clause:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_INITIAL_VALUE_BEFORE_RANGE_CLAUSE, "Expected an initial value before '{clause}'.", [TMessageArg.Create("clause", clause)])
	End Function
