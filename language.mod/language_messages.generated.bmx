		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_RANGE_ENDPOINT_REQUIRES_INT_CONVERSION, "Type '{typeName}' is not valid for a Range endpoint; conversion to Int is required.", [TMessageArg.Create("typeName", typeName)])
