		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_CONDITIONAL_SELECT_CLAUSE, "Expected 'Case', 'Default', or a conditional directive inside Select.")
	End Function
	Function ParserExpectedConditionalSelectEnd:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_CONDITIONAL_SELECT_END, "Expected '?' to end conditional Select clauses.")
	End Function
	Function ParserTryRejectsHeaderExpression:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_TRY_REJECTS_HEADER_EXPRESSION, "Try does not accept a header expression.")
	End Function
	Function ParserCatchCannotFollowFinally:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_CATCH_CANNOT_FOLLOW_FINALLY, "A Catch clause cannot follow Finally.")
	End Function
	Function ParserTryAllowsSingleFinally:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_TRY_ALLOWS_SINGLE_FINALLY, "A Try statement can contain only one Finally clause.")
	End Function
	Function ParserTryRequiresCatchOrFinally:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_TRY_REQUIRES_CATCH_OR_FINALLY, "A Try statement requires Catch or Finally.")
	End Function
	Function ParserExpectedEndTry:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_END_TRY, "Expected 'End Try' or 'EndTry'.")
	End Function
	Function ParserExpectedCaughtValueType:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_CAUGHT_VALUE_TYPE, "Expected a caught value type.")
	End Function
	Function ParserExpectedCaughtValueName:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_CAUGHT_VALUE_NAME, "Expected a caught value name.")
	End Function
	Function ParserFinallyRejectsHeaderExpression:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_FINALLY_REJECTS_HEADER_EXPRESSION, "Finally does not accept a header expression.")
	End Function
