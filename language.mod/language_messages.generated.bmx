		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_SLICE_BOUND_REQUIRES_INT_CONVERSION, "Type '{typeName}' is not valid for a slice bound; conversion to Int is required.", [TMessageArg.Create("typeName", typeName)])
