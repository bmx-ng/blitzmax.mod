		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_UNEXPECTED_TOKEN_AFTER_SOURCE_MODE, "Unexpected token '{token}' after '{mode}'.", [TMessageArg.Create("token", token), TMessageArg.Create("mode", mode)])
	End Function
	Function ParserVisibilityOnlyInsideType:TLocalisedMessage(visibility:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_VISIBILITY_ONLY_INSIDE_TYPE, "'{visibility}' visibility is only valid inside a type.", [TMessageArg.Create("visibility", visibility)])
	End Function
	Function ParserVisibilityNotValidForInterface:TLocalisedMessage(visibility:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_VISIBILITY_NOT_VALID_FOR_INTERFACE, "'{visibility}' visibility cannot be used with interfaces.", [TMessageArg.Create("visibility", visibility)])
	End Function
