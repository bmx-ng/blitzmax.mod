		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_CANNOT_INFER_EMPTY_ARRAY_LOCAL, "The type of local '{localName}' cannot be inferred from an empty array literal; write an explicit array type.", [TMessageArg.Create("localName", localName)])
	End Function
	Function BindingCannotInferNullLocal:TLocalisedMessage(localName:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_CANNOT_INFER_NULL_LOCAL, "The type of local '{localName}' cannot be inferred from Null; write an explicit reference type.", [TMessageArg.Create("localName", localName)])
	End Function
	Function BindingInferredLocalInitializerHasNoValue:TLocalisedMessage(localName:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_INFERRED_LOCAL_INITIALIZER_HAS_NO_VALUE, "The initializer for inferred local '{localName}' does not produce a value.", [TMessageArg.Create("localName", localName)])
	End Function
	Function BindingFunctionLiteralRequiresCallableTarget:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_FUNCTION_LITERAL_REQUIRES_CALLABLE_TARGET, "A Function literal requires an explicit callable target type.")
	End Function
