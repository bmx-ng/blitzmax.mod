		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_ENUM_NAME, "Expected an enum name.")
	End Function
	Function ParserExpectedEnumUnderlyingType:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_ENUM_UNDERLYING_TYPE, "Expected an enum underlying type after ':'.")
	End Function
	Function ParserExpectedEndEnum:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_END_ENUM, "Expected 'End Enum' before end of file.")
	End Function
	Function ParserExpectedEnumValueName:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_ENUM_VALUE_NAME, "Expected an enum value name.")
	End Function
	Function ParserExpectedConstantExpressionAfterEquals:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_CONSTANT_EXPRESSION_AFTER_EQUALS, "Expected a constant expression after '='.")
	End Function
