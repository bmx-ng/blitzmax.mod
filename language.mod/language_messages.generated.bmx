		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_CASE_CANNOT_FOLLOW_DEFAULT, "A Case clause cannot follow Default.")
	End Function
	Function ParserSelectAllowsSingleDefault:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_SELECT_ALLOWS_SINGLE_DEFAULT, "A Select statement can contain only one Default clause.")
	End Function
	Function ParserExpectedSelectClauseOrEnd:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_SELECT_CLAUSE_OR_END, "Expected 'Case', 'Default', or 'End Select'.")
	End Function
	Function ParserExpectedEndSelect:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_END_SELECT, "Expected 'End Select' or 'EndSelect'.")
	End Function
