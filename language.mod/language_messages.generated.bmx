		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_INDEX_EXPRESSION_REQUIRES_UINT_CONVERSION, "Type '{typeName}' is not valid for an index expression; conversion to UInt is required.", [TMessageArg.Create("typeName", typeName)])
	End Function
