		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_EXPLICIT_CONVERSION_NOT_AVAILABLE, "Type '{sourceType}' cannot be explicitly converted to '{targetType}'.", [TMessageArg.Create("sourceType", sourceType), TMessageArg.Create("targetType", targetType)])
	End Function
