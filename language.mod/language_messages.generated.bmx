		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_RANGE_SLICING_REJECTS_STATIC_ARRAY, "Range slicing requires a one-dimensional heap Array; StaticArray values are not supported.")
	End Function
