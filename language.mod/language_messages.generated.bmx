		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_LOCAL_RESOURCE_AFTER_USING, "Expected a Local resource declaration after Using.")
	End Function
	Function ParserUsingRequiresLocalResourcesBeforeDo:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_USING_REQUIRES_LOCAL_RESOURCES_BEFORE_DO, "Using requires Local resource declarations before Do.")
	End Function
	Function ParserUsingRequiresLocalResource:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_USING_REQUIRES_LOCAL_RESOURCE, "Using requires at least one Local resource declaration.")
	End Function
	Function ParserExpectedDoAfterUsingResources:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_DO_AFTER_USING_RESOURCES, "Expected 'Do' after Using resources.")
	End Function
	Function ParserExpectedEndUsing:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_END_USING, "Expected 'End Using' or 'EndUsing'.")
	End Function
	Function BindingYieldingRoutineRequiresIteratorReturn:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_YIELDING_ROUTINE_REQUIRES_ITERATOR_RETURN, "A routine containing Yield must return IIterator<T>, ICloseableIterator<T>, or a compatible iterator Interface.")
	End Function
	Function BindingArrayDimensionRequiresIntegralType:TLocalisedMessage(typeName:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_ARRAY_DIMENSION_REQUIRES_INTEGRAL_TYPE, "Type '{typeName}' is not valid for an array dimension; an integral type is required.", [TMessageArg.Create("typeName", typeName)])
	End Function
	Function BindingReadonlyFieldAssignmentRequiresConstructor:TLocalisedMessage(fieldName:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_READONLY_FIELD_ASSIGNMENT_REQUIRES_CONSTRUCTOR, "ReadOnly field '{fieldName}' can only be assigned in a constructor.", [TMessageArg.Create("fieldName", fieldName)])
	End Function
	Function BindingYieldingRoutineRequiresBareReturn:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_YIELDING_ROUTINE_REQUIRES_BARE_RETURN, "A yielding routine can use only bare Return to complete the iterator.")
	End Function
	Function BindingVoidRoutineReturnRejectsExpression:TLocalisedMessage(routineKind:String, routineName:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_VOID_ROUTINE_RETURN_REJECTS_EXPRESSION, "{routineKind} '{routineName}' does not return a value, so Return cannot include an expression.", [TMessageArg.Create("routineKind", routineKind), TMessageArg.Create("routineName", routineName)])
	End Function
	Function BindingModuleEntryReturnRequiresValue:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_MODULE_ENTRY_RETURN_REQUIRES_VALUE, "The module entry returns Int, so Return requires a value in SuperStrict code.")
	End Function
	Function BindingYieldRequiresRoutine:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_YIELD_REQUIRES_ROUTINE, "Yield is valid only inside a Function or Method.")
	End Function
	Function BindingReleaseRequiresWritableInteger:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_RELEASE_REQUIRES_WRITABLE_INTEGER, "Release requires a writable integer variable.")
	End Function
	Function BindingReleaseRequiresInteger:TLocalisedMessage(typeName:String)
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_RELEASE_REQUIRES_INTEGER, "Release requires an integer variable, not '{typeName}'.", [TMessageArg.Create("typeName", typeName)])
	End Function
	Function BindingSelectAllowsSingleActiveDefault:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_SELECT_ALLOWS_SINGLE_ACTIVE_DEFAULT, "A Select statement can contain only one active Default clause.")
	End Function
