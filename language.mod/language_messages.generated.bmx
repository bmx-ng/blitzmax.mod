	End Function
	Function BindingNamedCastRequiresOneExpression:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_NAMED_CAST_REQUIRES_ONE_EXPRESSION, "A named type cast requires exactly one expression.")
	End Function
