		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_INTERFACE_NOT_INHERITED_BY_CURRENT_TYPE, "Interface '{interfaceName}' is not inherited by the current type.", [TMessageArg.Create("interfaceName", interfaceName)])
	End Function
	Function BindingBoundMethodReceiverRequiresReferenceType:TLocalisedMessage()
