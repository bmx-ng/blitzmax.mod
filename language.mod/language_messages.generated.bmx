		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_BINDING_TYPE_HAS_NO_APPLICABLE_INDEXING_OPERATOR, "Type '{typeName}' does not provide an applicable indexing operator.", [TMessageArg.Create("typeName", typeName)])
	End Function
