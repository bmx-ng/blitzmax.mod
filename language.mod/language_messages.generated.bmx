		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_RANGE_LIMIT_AFTER_CLAUSE, "Expected a range limit after '{clause}'.", [TMessageArg.Create("clause", clause)])
	End Function
	Function ParserExpectedExpressionAfterStep:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_EXPRESSION_AFTER_STEP, "Expected an expression after 'Step'.")
	End Function
	Function ParserExpectedLocalLoopVariableBetweenCommas:TLocalisedMessage()
		Return TLocalisedMessage.Create("language", LANGUAGE_MSG_PARSER_EXPECTED_LOCAL_LOOP_VARIABLE_BETWEEN_COMMAS, "Expected a local loop variable between commas.")
	End Function
